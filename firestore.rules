rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // User-scoped Workspaces
    // -------------------------------------------------------------
    match /users/{userId} {
      // 1. Published Employee Schedules:
      // - 'get' is permitted ONLY for a specific document with the shared cryptographic ID.
      // - 'list' is strictly FORBIDDEN to prevent collection enumeration / scraping.
      // - 'write' is restricted strictly to the authenticated manager owning the workspace.
      match /employeeSchedules/{scheduleId} {
        allow get: if true;
        allow list: if false;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. Manager private workspaces (appData, officialSchedules, and any other subcollections):
      // Only the authenticated manager can read, list, or write.
      match /appData/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /officialSchedules/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all for any other user-scoped documents:
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // -------------------------------------------------------------
    // Legacy Un-scoped Collection (Backward compatibility for older links)
    // -------------------------------------------------------------
    match /employeeSchedules/{scheduleId} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }
  }
}
